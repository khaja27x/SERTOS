# SERTOS Environment Configuration Template
# Copy this file to .env and replace placeholder values with your secure secrets.

# Core Application Settings
DEBUG=True
SECRET_KEY=replace-with-a-secure-50-character-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# PostgreSQL Database Configuration
DB_NAME=sertos_db
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Allowed Origins (Web Dashboards)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
