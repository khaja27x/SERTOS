# ==============================================================================
# SERTOS Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development, or configure these variables
# directly in your cloud hosting provider dashboard (e.g. Render, Railway, Neon).

# Core Application Settings
DEBUG=True
DB_ENGINE=sqlite
SECRET_KEY=replace-with-a-secure-50-character-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2,.onrender.com

# PostgreSQL Database Configuration
# Option A: Single Connection String (Recommended for Cloud PaaS like Render/Neon/Railway/Supabase)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Option B: Individual Database Parameters (Local Development fallback)
DB_NAME=sertos_db
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Allowed Origins (Web Dashboards & Frontends)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Production Security
# Enable/disable SSL redirect (defaults to True when DEBUG=False)
SECURE_SSL_REDIRECT=True

# Optional External API Keys (Leave blank if not used)
GOOGLE_MAPS_API_KEY=
